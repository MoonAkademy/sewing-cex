<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Швейный цех</title>
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#1a1815">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Швейный цех">
<link rel="apple-touch-icon" href="icon-192.png">
<link rel="icon" href="icon-192.png">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#f4f2ed;--paper:#fbfaf7;--ink:#1a1815;--ink-soft:#6b675e;--ink-faint:#a8a399;
    --line:#e3dfd6;--line-soft:#ece9e1;
    --new:#5b8def;--work:#e8923a;--check:#9b6bd6;--ready:#3aa86b;--issued:#a8a399;
    --red:#d2563f;--green:#3aa86b;--r:12px;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:'DM Mono',monospace;background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased;padding-bottom:calc(40px + env(safe-area-inset-bottom));}
  ::selection{background:var(--ink);color:var(--paper);}

  header{display:flex;align-items:center;gap:18px;padding:calc(22px + env(safe-area-inset-top)) 28px 22px;border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--bg);z-index:50;flex-wrap:wrap;}
  .brand{font-family:'Syne',sans-serif;font-weight:800;font-size:18px;letter-spacing:-.02em;display:flex;align-items:center;gap:11px;}
  .brand .dot{width:9px;height:9px;border-radius:50%;background:var(--ink);}
  .tabs{display:flex;gap:4px;background:var(--line-soft);padding:3px;border-radius:10px;}
  .tab{font-family:'Syne',sans-serif;font-weight:600;font-size:12px;border:none;background:transparent;color:var(--ink-soft);padding:8px 16px;border-radius:8px;cursor:pointer;transition:all .15s;}
  .tab.on{background:var(--paper);color:var(--ink);box-shadow:0 1px 3px rgba(26,24,21,.08);}
  .btn{font-family:'Syne',sans-serif;font-weight:700;font-size:12px;letter-spacing:.02em;background:var(--ink);color:var(--paper);border:none;border-radius:var(--r);padding:11px 18px;cursor:pointer;transition:transform .12s,opacity .15s;margin-left:auto;}
  .btn:hover{opacity:.85;}
  .btn:active{transform:scale(.97);}
  .btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line);margin-left:0;}

  .stats{display:grid;gap:1px;background:var(--line);border-bottom:1px solid var(--line);}
  .stats.c4{grid-template-columns:repeat(4,1fr);}
  .stats.c3{grid-template-columns:repeat(3,1fr);}
  .stat{background:var(--bg);padding:18px 28px;}
  .stat .k{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-faint);}
  .stat .v{font-family:'Syne',sans-serif;font-weight:800;font-size:26px;letter-spacing:-.02em;margin-top:4px;}
  .stat .v.red{color:var(--red);}

  .toolbar{display:flex;align-items:center;gap:10px;padding:18px 28px;flex-wrap:wrap;}
  .search{flex:1;min-width:220px;position:relative;}
  .search input{width:100%;font-family:'DM Mono';font-size:13px;color:var(--ink);background:var(--paper);border:1px solid var(--line);border-radius:var(--r);padding:11px 14px 11px 36px;outline:none;transition:border-color .15s;}
  .search input:focus{border-color:var(--ink);}
  .search svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.4;}
  .filters{display:flex;gap:6px;flex-wrap:wrap;}
  .chip{font-family:'DM Mono';font-size:11.5px;letter-spacing:.02em;cursor:pointer;background:var(--paper);border:1px solid var(--line);border-radius:99px;padding:8px 13px;color:var(--ink-soft);transition:all .14s;display:flex;align-items:center;gap:7px;}
  .chip:hover{border-color:var(--ink-faint);}
  .chip.on{background:var(--ink);color:var(--paper);border-color:var(--ink);}
  .chip .cdot{width:7px;height:7px;border-radius:50%;}

  .wrap{padding:0 28px;overflow-x:auto;}
  table{width:100%;border-collapse:collapse;background:var(--paper);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;}
  #tbl-orders{min-width:980px;}
  #tbl-workers{min-width:960px;table-layout:fixed;}
  thead th{font-family:'DM Mono';font-weight:500;font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-faint);text-align:left;padding:13px 14px;border-bottom:1px solid var(--line);cursor:pointer;user-select:none;white-space:nowrap;}
  thead th.mh{text-align:center;cursor:default;font-size:9px;padding:13px 4px;}
  thead th.nc{cursor:default;}
  thead th:hover{color:var(--ink);}
  tbody tr{border-bottom:1px solid var(--line-soft);transition:background .12s;}
  tbody tr:last-child{border-bottom:none;}
  #tbl-orders tbody tr{cursor:pointer;}
  #tbl-orders tbody tr:hover{background:var(--bg);}
  #tbl-workers tbody tr:hover{background:var(--bg);}
  td{padding:11px 14px;font-size:13px;vertical-align:middle;}
  .client-cell{display:flex;align-items:center;gap:9px;}
  .sdot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
  .client-name{font-weight:500;}
  .sub{font-size:11px;color:var(--ink-soft);margin-top:2px;}
  .date.over{color:var(--red);font-weight:500;}
  .qty{font-family:'Syne',sans-serif;font-weight:700;font-size:15px;text-align:center;}
  .mat-cell{text-align:center;padding:8px 4px;}
  .mat-cell input{width:50px;font-family:'DM Mono';font-size:13px;text-align:center;background:transparent;border:1px solid transparent;border-radius:6px;padding:6px 2px;color:var(--ink);transition:border-color .12s;}
  .mat-cell input:hover{border-color:var(--line);}
  .mat-cell input:focus{border-color:var(--ink);outline:none;background:var(--bg);}
  .mat-cell input.zero{color:var(--ink-faint);opacity:.55;}
  .mat-cell input.has{color:var(--green);font-weight:500;}
  .empty{text-align:center;padding:60px 20px;color:var(--ink-faint);font-size:13px;}

  /* worker inline inputs */
  .winput{width:100%;font-family:'DM Mono';font-size:13px;background:transparent;border:1px solid transparent;border-radius:7px;padding:8px 9px;color:var(--ink);transition:border-color .12s;}
  .winput:hover{border-color:var(--line);}
  .winput:focus{border-color:var(--ink);outline:none;background:var(--bg);}
  select.winput{cursor:pointer;-webkit-appearance:none;appearance:none;background-image:url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%23a8a399' stroke-width='1.5'/%3E%3C/svg%3E");background-repeat:no-repeat;background-position:right 9px center;padding-right:24px;}
  .winput.num{text-align:left;}
  .over .winput{color:var(--red);}
  .stepper{display:inline-flex;align-items:center;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--bg);}
  .stepper button{width:30px;height:34px;border:none;background:transparent;color:var(--ink-soft);font-size:17px;cursor:pointer;line-height:1;display:flex;align-items:center;justify-content:center;transition:background .12s;flex-shrink:0;}
  .stepper button:hover{background:var(--line-soft);color:var(--ink);}
  .stepper button:active{background:var(--line);}
  .stepper input{width:46px;border:none;background:transparent;text-align:center;font-family:'DM Mono';font-size:13px;color:var(--ink);outline:none;padding:8px 0;-moz-appearance:textfield;}
  .stepper input::-webkit-outer-spin-button,.stepper input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0;}
  .wsum{font-family:'Syne',sans-serif;font-weight:700;font-size:14px;white-space:nowrap;}
  .delx{background:none;border:none;color:var(--ink-faint);font-size:18px;cursor:pointer;line-height:1;padding:2px 6px;border-radius:6px;}
  .delx:hover{color:var(--red);background:rgba(210,86,63,.1);}
  tfoot td{padding:13px 14px;border-top:1px solid var(--line);font-family:'Syne';font-weight:700;font-size:13px;}

  .overlay{position:fixed;inset:0;background:rgba(26,24,21,.32);backdrop-filter:blur(2px);opacity:0;pointer-events:none;transition:opacity .2s;z-index:90;}
  .overlay.show{opacity:1;pointer-events:auto;}
  .panel{position:fixed;top:0;right:0;height:100%;width:420px;max-width:92vw;background:var(--paper);border-left:1px solid var(--line);box-shadow:-20px 0 50px rgba(26,24,21,.12);transform:translateX(100%);transition:transform .26s cubic-bezier(.4,0,.1,1);z-index:100;display:flex;flex-direction:column;}
  .panel.show{transform:translateX(0);}
  .panel-head{padding:22px 24px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:flex-start;}
  .panel-head h2{font-family:'Syne',sans-serif;font-weight:800;font-size:20px;letter-spacing:-.02em;}
  .panel-head .num{margin-top:3px;color:var(--ink-faint);font-size:11px;}
  .x{background:none;border:none;font-size:22px;cursor:pointer;color:var(--ink-soft);line-height:1;padding:0 4px;}
  .panel-body{padding:22px 24px;overflow-y:auto;flex:1;}
  .field{margin-bottom:16px;}
  .field label{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.07em;color:var(--ink-faint);margin-bottom:6px;}
  .field input,.field select,.field textarea{width:100%;font-family:'DM Mono';font-size:13px;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:9px;padding:10px 12px;outline:none;transition:border-color .15s;}
  .field select{cursor:pointer;-webkit-appearance:none;appearance:none;background-image:url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%23a8a399' stroke-width='1.5'/%3E%3C/svg%3E");background-repeat:no-repeat;background-position:right 12px center;padding-right:30px;}
  .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--ink);}
  .field textarea{resize:vertical;min-height:60px;}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .matgrid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;}
  .matnum label{font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-faint);margin-bottom:5px;display:block;}
  .matnum input{width:100%;font-family:'DM Mono';font-size:13px;text-align:center;background:var(--bg);border:1px solid var(--line);border-radius:9px;padding:9px 4px;outline:none;}
  .matnum input:focus{border-color:var(--ink);}
  .timeline{display:flex;justify-content:space-between;margin:8px 0 20px;position:relative;}
  .timeline::before{content:'';position:absolute;top:5px;left:5%;right:5%;height:1px;background:var(--line);z-index:0;}
  .tl-step{display:flex;flex-direction:column;align-items:center;gap:6px;z-index:1;flex:1;}
  .tl-dot{width:11px;height:11px;border-radius:50%;background:var(--line);border:2px solid var(--paper);}
  .tl-step.done .tl-dot{background:var(--ink);}
  .tl-step span{font-size:8.5px;text-transform:uppercase;letter-spacing:.03em;color:var(--ink-faint);text-align:center;}
  .tl-step.done span{color:var(--ink);}
  .panel-foot{padding:16px 24px;border-top:1px solid var(--line);display:flex;gap:10px;}
  .panel-foot .btn{flex:1;margin-left:0;}
  .danger{color:var(--red);border-color:rgba(210,86,63,.4);}
  .matview{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;}
  .matview div{background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:8px;text-align:center;}
  .matview .ml{font-size:9px;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-faint);}
  .matview .mv{font-family:'Syne';font-weight:700;font-size:16px;margin-top:2px;}
  .matview .mv.z{color:var(--ink-faint);}

  .settings-wrap{padding:28px;max-width:560px;display:flex;flex-direction:column;gap:20px;}
  .settings-card{background:var(--paper);border:1px solid var(--line);border-radius:var(--r);padding:24px;}
  .settings-card h3{font-family:'Syne';font-weight:800;font-size:17px;letter-spacing:-.01em;margin-bottom:4px;}
  .settings-card .hint{font-size:12px;color:var(--ink-soft);margin-bottom:18px;}
  .add-row{display:flex;gap:8px;margin-bottom:18px;}
  .add-row input{flex:1;font-family:'DM Mono';font-size:13px;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:9px;padding:11px 12px;outline:none;transition:border-color .15s;}
  .add-row input:focus{border-color:var(--ink);}
  .add-row .btn{margin-left:0;}
  .tag-list{display:flex;flex-wrap:wrap;gap:8px;}
  .tag{display:inline-flex;align-items:center;gap:8px;background:var(--bg);border:1px solid var(--line);border-radius:99px;padding:8px 8px 8px 14px;font-size:13px;}
  .tag button{background:none;border:none;color:var(--ink-faint);font-size:16px;cursor:pointer;line-height:1;width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:all .12s;}
  .tag button:hover{background:rgba(210,86,63,.12);color:var(--red);}
  .tag-list .empty{padding:0;color:var(--ink-faint);font-size:12px;}
  .client-item{border:1px solid var(--line);border-radius:10px;padding:14px;margin-bottom:10px;background:var(--bg);}
  .client-item:last-child{margin-bottom:0;}
  .client-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px;}
  .client-top .ci-name{font-family:'Syne';font-weight:700;font-size:14px;}
  .client-top .ci-phone{font-size:12px;color:var(--ink-soft);}
  .client-top button{background:none;border:none;color:var(--ink-faint);font-size:18px;cursor:pointer;line-height:1;padding:2px 6px;border-radius:6px;}
  .client-top button:hover{background:rgba(210,86,63,.12);color:var(--red);}
  .ci-types-label{font-size:9px;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-faint);margin-bottom:7px;}
  .ci-add{display:flex;gap:6px;margin-top:8px;}
  .ci-add input{flex:1;font-family:'DM Mono';font-size:12px;background:var(--paper);border:1px solid var(--line);border-radius:7px;padding:7px 9px;outline:none;}
  .ci-add input:focus{border-color:var(--ink);}
  .ci-add button{font-family:'Syne';font-weight:600;font-size:11px;background:transparent;border:1px solid var(--line);border-radius:7px;padding:0 12px;cursor:pointer;color:var(--ink);}
  .clist-empty{color:var(--ink-faint);font-size:12px;}

  /* FAB + bottom nav — скрыты на десктопе */
  .fab{display:none;}
  .bottomnav{display:none;}

  @media(max-width:760px){
    body{padding-bottom:calc(72px + env(safe-area-inset-bottom));}

    /* header: бренд + действие, табы уезжают в низ */
    header{padding:calc(14px + env(safe-area-inset-top)) 18px 14px;gap:12px;}
    .brand{font-size:17px;}
    .tabs{display:none;}
    #addBtn{display:none!important;}

    /* статы — компактные карточки в ряд со скроллом */
    .stats.c4,.stats.c3{display:flex;gap:8px;background:transparent;border:none;padding:14px 18px 4px;overflow-x:auto;-webkit-overflow-scrolling:touch;}
    .stats.c4::-webkit-scrollbar,.stats.c3::-webkit-scrollbar{display:none;}
    .stat{flex:0 0 auto;min-width:128px;background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:14px 16px;}
    .stat .k{font-size:9px;}
    .stat .v{font-size:21px;margin-top:3px;}

    .toolbar{padding:10px 18px;}
    .search input{padding:13px 14px 13px 38px;font-size:15px;border-radius:14px;}
    .filters{gap:7px;overflow-x:auto;flex-wrap:nowrap;padding-bottom:2px;}
    .filters::-webkit-scrollbar{display:none;}
    .chip{flex:0 0 auto;padding:10px 14px;font-size:12.5px;}

    .wrap{padding:4px 14px 14px;overflow-x:visible;}
    #tbl-orders,#tbl-workers{min-width:0;border:none;background:transparent;border-radius:0;}
    table thead{display:none;}
    table tfoot{display:none;}
    table,tbody,tr,td{display:block;width:100%;}
    table colgroup{display:none;}

    /* ЗАКАЗ как карточка */
    #tbl-orders tbody tr{position:relative;display:flex;flex-wrap:wrap;align-items:flex-start;padding:16px;border:1px solid var(--line);border-radius:16px;margin-bottom:12px;background:var(--paper);box-shadow:0 1px 2px rgba(26,24,21,.04);}
    #tbl-orders td{padding:0;border:none;text-align:left!important;}
    #tbl-orders td::before{content:attr(data-l);display:block;font-size:9px;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-faint);margin-bottom:2px;}
    #tbl-orders td[data-l="Заказчик"]{order:1;width:100%;margin-bottom:14px;}
    #tbl-orders td[data-l="Заказчик"]::before{display:none;}
    #tbl-orders .client-name{font-family:'Syne';font-weight:700;font-size:16px;}
    #tbl-orders .sub{font-size:12px;}
    #tbl-orders td[data-l="Вид заказа"]{order:2;width:50%;margin-bottom:14px;font-size:14px;}
    #tbl-orders td[data-l="Кол-во"]{order:3;width:50%;margin-bottom:14px;}
    #tbl-orders td.qty{font-size:14px;text-align:left;}
    #tbl-orders td[data-l="Дата"]{order:4;width:50%;margin-bottom:14px;font-size:14px;}
    #tbl-orders td[data-l="Сдать до"]{order:5;width:50%;margin-bottom:14px;font-size:14px;}
    /* материалы — сетка 3 в ряд */
    #tbl-orders td.mat-cell{order:6;width:calc(33.333% - 6px);margin-right:9px;padding:2px 0 0;text-align:center!important;}
    #tbl-orders td.mat-cell:nth-of-type(3n+1){margin-right:0;}
    #tbl-orders td.mat-cell::before{text-align:center;margin-bottom:5px;}
    #tbl-orders td.mat-cell input{width:100%;height:44px;border:1px solid var(--line);border-radius:11px;font-size:16px;background:var(--bg);}

    /* РАБОТНИК как карточка */
    #tbl-workers tbody tr{display:flex;flex-wrap:wrap;padding:16px;border:1px solid var(--line);border-radius:16px;margin-bottom:12px;background:var(--paper);box-shadow:0 1px 2px rgba(26,24,21,.04);position:relative;}
    #tbl-workers td{padding:0 0 12px;border:none;text-align:left!important;width:100%;}
    #tbl-workers td::before{content:attr(data-l);display:block;font-size:9px;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-faint);margin-bottom:5px;}
    #tbl-workers .winput{width:100%;border:1px solid var(--line);border-radius:10px;padding:11px 12px;font-size:15px;background:var(--bg);}
    #tbl-workers td[data-l="Имя"]{width:70%;}
    #tbl-workers td[data-l="Тип работы"]{width:100%;}
    #tbl-workers td[data-l="Тип изделия"]{width:50%;padding-right:10px;}
    #tbl-workers td[data-l="Сдать до"]{width:50%;}
    #tbl-workers td[data-l="Сделано"],#tbl-workers td[data-l="Цена/ед"]{width:50%;}
    #tbl-workers td[data-l="Цена/ед"]{padding-left:10px;}
    #tbl-workers .stepper{width:100%;height:46px;}
    #tbl-workers .stepper input{flex:1;width:auto;min-width:0;font-size:16px;text-align:center;}
    #tbl-workers .stepper button{width:44px;height:44px;font-size:20px;flex-shrink:0;}
    #tbl-workers td[data-l="Сумма"]{padding:4px 0 0;}
    #tbl-workers td[data-l="Сумма"]::before{display:inline;margin-right:8px;}
    #tbl-workers .wsum{font-size:18px;}
    #tbl-workers td:last-child{padding:0;width:auto;}
    #tbl-workers td:last-child::before{display:none;}
    #tbl-workers .delx{position:absolute;top:14px;right:14px;font-size:24px;padding:4px 8px;}

    /* панель — bottom sheet */
    .panel{top:auto;bottom:0;right:0;left:0;width:100%;max-width:100%;height:auto;max-height:92vh;border-left:none;border-top:1px solid var(--line);border-radius:22px 22px 0 0;transform:translateY(100%);box-shadow:0 -10px 40px rgba(26,24,21,.18);}
    .panel.show{transform:translateY(0);}
    .panel-head{padding:20px 20px 16px;position:relative;}
    .panel-head::before{content:'';position:absolute;top:8px;left:50%;transform:translateX(-50%);width:38px;height:4px;border-radius:99px;background:var(--line);}
    .panel-body{padding:8px 20px 20px;}
    .panel-foot{padding:14px 20px calc(16px + env(safe-area-inset-bottom));}
    .panel-foot .btn{padding:15px 18px;font-size:14px;}
    .field input,.field select,.field textarea{padding:13px 12px;font-size:16px;border-radius:11px;}
    .field select{background-position:right 14px center;}

    /* настройки на всю ширину */
    .settings-wrap{padding:16px 14px;max-width:100%;}
    .settings-card{padding:18px;border-radius:16px;}
    .add-row{flex-wrap:wrap;}
    .add-row input{font-size:16px;padding:13px 12px;border-radius:11px;}
    .add-row #newClientPhone{max-width:100%!important;}
    .add-row .btn{padding:13px 18px;}
    .ci-add input{font-size:15px;padding:11px 10px;}
    .ci-add button{padding:0 16px;font-size:13px;}
    .tag{padding:10px 10px 10px 14px;font-size:14px;}
    .tag button{width:24px;height:24px;font-size:18px;}

    /* FAB */
    .fab{display:flex;align-items:center;justify-content:center;position:fixed;right:18px;bottom:calc(80px + env(safe-area-inset-bottom));width:58px;height:58px;border-radius:50%;background:var(--ink);color:var(--paper);border:none;font-size:30px;font-weight:300;line-height:1;cursor:pointer;z-index:80;box-shadow:0 6px 20px rgba(26,24,21,.28);transition:transform .15s;}
    .fab:active{transform:scale(.92);}

    /* нижняя навигация */
    .bottomnav{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:85;background:var(--paper);border-top:1px solid var(--line);padding:8px 6px calc(8px + env(safe-area-inset-bottom));}
    .bn{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;background:none;border:none;cursor:pointer;color:var(--ink-faint);padding:6px 0;transition:color .15s;}
    .bn svg{width:22px;height:22px;}
    .bn span{font-family:'Syne';font-weight:600;font-size:10px;letter-spacing:.01em;}
    .bn.on{color:var(--ink);}
  }

  @media(max-width:380px){
    #tbl-orders td[data-l="Вид заказа"],#tbl-orders td[data-l="Дата"],#tbl-orders td[data-l="Сдать до"],#tbl-orders td[data-l="Кол-во"]{width:100%;}
  }
</style>
</head>
<body>

<header>
  <div class="brand"><span class="dot"></span>Швейный цех</div>
  <nav class="tabs">
    <button class="tab on" data-v="orders" onclick="switchView('orders')">Заказы</button>
    <button class="tab" data-v="workers" onclick="switchView('workers')">Работники</button>
    <button class="tab" data-v="settings" onclick="switchView('settings')">Настройки</button>
  </nav>
  <button class="btn" id="addBtn" onclick="primaryAdd()">+ Новый заказ</button>
</header>

<!-- ================= ЗАКАЗЫ ================= -->
<div id="view-orders">
  <div class="stats c4">
    <div class="stat"><div class="k">Активные</div><div class="v" id="s-active">0</div></div>
    <div class="stat"><div class="k">Просрочено</div><div class="v red" id="s-over">0</div></div>
    <div class="stat"><div class="k">Сумма / месяц</div><div class="v" id="s-rev">0</div></div>
    <div class="stat"><div class="k">Долги</div><div class="v" id="s-debt">0</div></div>
  </div>
  <div class="toolbar">
    <div class="search">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4-4"/></svg>
      <input id="q" placeholder="Поиск: заказчик, вид заказа…" oninput="render()">
    </div>
    <div class="filters" id="filters"></div>
  </div>
  <div class="wrap">
    <table id="tbl-orders">
      <thead>
        <tr>
          <th onclick="sortBy('client')">Заказчик</th>
          <th onclick="sortBy('item')">Вид заказа</th>
          <th onclick="sortBy('date')">Дата</th>
          <th onclick="sortBy('deadline')">Сдать до</th>
          <th class="mh">Рулоны</th>
          <th class="mh">Нитки</th>
          <th class="mh">Пугов.</th>
          <th class="mh">Пакеты</th>
          <th class="mh">Лейба</th>
          <th class="mh">Плечи</th>
          <th onclick="sortBy('qty')">Кол-во</th>
        </tr>
      </thead>
      <tbody id="rows"></tbody>
    </table>
  </div>
</div>

<!-- ================= РАБОТНИКИ ================= -->
<div id="view-workers" style="display:none">
  <div class="stats c3">
    <div class="stat"><div class="k">Работников</div><div class="v" id="w-count">0</div></div>
    <div class="stat"><div class="k">Изделий сделано</div><div class="v" id="w-items">0</div></div>
    <div class="stat"><div class="k">Итого к выплате</div><div class="v" id="w-pay">0</div></div>
  </div>
  <div class="toolbar">
    <div class="search">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4-4"/></svg>
      <input id="wq" placeholder="Поиск: имя, тип работы…" oninput="renderWorkers()">
    </div>
  </div>
  <div class="wrap">
    <table id="tbl-workers">
      <colgroup>
        <col style="width:16%"><col style="width:13%"><col style="width:13%"><col style="width:14%"><col style="width:14%"><col style="width:14%"><col style="width:12%"><col style="width:44px">
      </colgroup>
      <thead>
        <tr>
          <th class="nc">Имя</th>
          <th class="nc">Тип работы</th>
          <th class="nc">Тип изделия</th>
          <th class="nc">Сдать до</th>
          <th class="nc">Сделано</th>
          <th class="nc">Цена / ед</th>
          <th class="nc">Сумма</th>
          <th class="nc"></th>
        </tr>
      </thead>
      <tbody id="wrows"></tbody>
      <tfoot><tr><td colspan="6">Итого</td><td class="wsum" id="w-total">0</td><td></td></tr></tfoot>
    </table>
  </div>
</div>

<!-- ================= НАСТРОЙКИ ================= -->
<div id="view-settings" style="display:none">
  <div class="settings-wrap">
    <div class="settings-card">
      <h3>Заказчики</h3>
      <p class="hint">Заказчик, его телефон и виды заказа. В заказе выбираешь заказчика — телефон и виды подставляются.</p>
      <div class="add-row">
        <input id="newClientName" placeholder="Имя заказчика">
        <input id="newClientPhone" placeholder="0700 00 00 00" inputmode="numeric" oninput="maskKG(this)" style="max-width:150px">
        <button class="btn ghost" onclick="addClient()">Добавить</button>
      </div>
      <div id="clientList"></div>
    </div>

    <div class="settings-card">
      <h3>Типы изделий</h3>
      <p class="hint">Общий список — используется и в заказах (вид заказа), и у работников.</p>
      <div class="add-row">
        <input id="newType" placeholder="Например: пальто" onkeydown="if(event.key==='Enter')addType()">
        <button class="btn ghost" onclick="addType()">Добавить</button>
      </div>
      <div class="tag-list" id="typeList"></div>
    </div>

    <div class="settings-card">
      <h3>Технологи</h3>
      <p class="hint">Появляются в списке при создании заказа.</p>
      <div class="add-row">
        <input id="newTech" placeholder="Имя технолога" onkeydown="if(event.key==='Enter')addTech()">
        <button class="btn ghost" onclick="addTech()">Добавить</button>
      </div>
      <div class="tag-list" id="techList"></div>
    </div>
  </div>
</div>

<div class="overlay" id="overlay" onclick="closePanel()"></div>
<aside class="panel" id="panel">
  <div class="panel-head">
    <div><h2 id="p-title">Заказ</h2><div class="num" id="p-num"></div></div>
    <button class="x" onclick="closePanel()">×</button>
  </div>
  <div class="panel-body" id="p-body"></div>
  <div class="panel-foot" id="p-foot"></div>
</aside>

<button class="fab" id="fab" onclick="primaryAdd()" aria-label="Добавить">+</button>

<nav class="bottomnav">
  <button class="bn on" data-v="orders" onclick="switchView('orders')">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
    <span>Заказы</span>
  </button>
  <button class="bn" data-v="workers" onclick="switchView('workers')">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="7" r="3"/><path d="M2 21v-1a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v1"/><path d="M17 11l2 2 4-4"/></svg>
    <span>Работники</span>
  </button>
  <button class="bn" data-v="settings" onclick="switchView('settings')">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
    <span>Настройки</span>
  </button>
</nav>

<script>
/* ===== общее ===== */
function uid(){return Math.random().toString(36).slice(2,9);}
function fmt(n){return Number(n||0).toLocaleString('ru-RU')+' с';}
function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}

let view='orders';
function switchView(v){
  view=v;
  document.getElementById('view-orders').style.display=v==='orders'?'':'none';
  document.getElementById('view-workers').style.display=v==='workers'?'':'none';
  document.getElementById('view-settings').style.display=v==='settings'?'':'none';
  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('on',t.dataset.v===v));
  document.querySelectorAll('.bn').forEach(t=>t.classList.toggle('on',t.dataset.v===v));
  const btn=document.getElementById('addBtn');
  const fab=document.getElementById('fab');
  if(v==='settings'){btn.style.display='none';if(fab)fab.style.display='none';}
  else{btn.style.display='';if(fab)fab.style.display='';btn.textContent=v==='orders'?'+ Новый заказ':'+ Добавить работника';}
}
function primaryAdd(){view==='orders'?openNew():addWorker();}

/* ===== ЗАКАЗЫ ===== */
const STATUSES=[
  {id:'new',label:'Новый',color:'var(--new)'},
  {id:'work',label:'В работе',color:'var(--work)'},
  {id:'check',label:'Проверка',color:'var(--check)'},
  {id:'ready',label:'Готово',color:'var(--ready)'},
  {id:'issued',label:'Выдано',color:'var(--issued)'},
];
const MATS=[
  {k:'tkan',l:'Рулоны'},{k:'nitki',l:'Нитки'},{k:'pugovicy',l:'Пуговицы'},
  {k:'pakety',l:'Пакеты'},{k:'leyba',l:'Лейба'},{k:'plechi',l:'Плечи'}
];
const sColor=id=>(STATUSES.find(s=>s.id===id)||{}).color||'var(--line)';
const sLabel=id=>(STATUSES.find(s=>s.id===id)||{}).label||id;

const OKEY='sewing_orders_v3';
let orders=loadOrders();
let filter='all',sortKey='date',sortDir=-1;

function loadOrders(){try{const d=JSON.parse(localStorage.getItem(OKEY));if(Array.isArray(d))return d;}catch(e){}return seedOrders();}
function saveOrders(){localStorage.setItem(OKEY,JSON.stringify(orders));}
function seedOrders(){
  const t=new Date();const d=n=>{const x=new Date(t);x.setDate(x.getDate()+n);return x.toISOString().slice(0,10);};
  return [
    {id:uid(),number:'ЗК-1042',client:'Айгерим С.',phone:'0700123456',item:'платье',date:d(-2),deadline:d(3),qty:1,master:'Гульнара',status:'work',total:8500,prepaid:4000,priority:'high',mats:{tkan:4,nitki:2,pugovicy:6,pakety:1,leyba:1,plechi:1},notes:'Размер 44'},
    {id:uid(),number:'ЗК-1041',client:'Эрмек Т.',phone:'0555987654',item:'костюм',date:d(-6),deadline:d(-1),qty:3,master:'Айбек',status:'check',total:21000,prepaid:21000,priority:'normal',mats:{tkan:9,nitki:6,pugovicy:18,pakety:3,leyba:3,plechi:6},notes:''},
    {id:uid(),number:'ЗК-1040',client:'Школа №7',phone:'0312442211',item:'рубашка',date:d(-1),deadline:d(9),qty:12,master:'Гульнара',status:'new',total:36000,prepaid:10000,priority:'high',mats:{tkan:30,nitki:0,pugovicy:0,pakety:0,leyba:12,plechi:0},notes:'Партия'},
    {id:uid(),number:'ЗК-1039',client:'Назгуль К.',phone:'0770332210',item:'юбка',date:d(-4),deadline:d(0),qty:1,master:'Жылдыз',status:'ready',total:3200,prepaid:1500,priority:'normal',mats:{tkan:2,nitki:1,pugovicy:1,pakety:1,leyba:1,plechi:1},notes:'Ждёт выдачи'},
  ];
}
function isOver(o){return o.status!=='issued'&&o.status!=='ready'&&o.deadline&&o.deadline<new Date().toISOString().slice(0,10);}

function buildFilters(){
  const el=document.getElementById('filters');const c={all:orders.length};
  STATUSES.forEach(s=>c[s.id]=orders.filter(o=>o.status===s.id).length);
  let h=`<div class="chip ${filter==='all'?'on':''}" onclick="setFilter('all')">Все · ${c.all}</div>`;
  STATUSES.forEach(s=>h+=`<div class="chip ${filter===s.id?'on':''}" onclick="setFilter('${s.id}')"><span class="cdot" style="background:${s.color}"></span>${s.label} · ${c[s.id]}</div>`);
  el.innerHTML=h;
}
function setFilter(f){filter=f;render();}
function sortBy(k){if(sortKey===k)sortDir*=-1;else{sortKey=k;sortDir=1;}render();}

function matCell(o,k){
  const v=(o.mats&&o.mats[k])||0;const m=MATS.find(x=>x.k===k);
  return `<td class="mat-cell" data-l="${m.l}"><input type="number" min="0" step="any" class="${v>0?'has':'zero'}" value="${v}" onclick="event.stopPropagation()" onfocus="this.select()" onchange="setMat('${o.id}','${k}',this)"></td>`;
}
function setMat(id,k,el){const o=orders.find(x=>x.id===id);if(!o.mats)o.mats={};const v=Math.max(0,+el.value||0);o.mats[k]=v;el.value=v;el.className=v>0?'has':'zero';saveOrders();}

function render(){
  buildFilters();
  const q=document.getElementById('q').value.toLowerCase().trim();
  let list=orders.filter(o=>filter==='all'||o.status===filter);
  if(q)list=list.filter(o=>(o.client+o.item+o.number+(o.master||'')).toLowerCase().includes(q));
  list.sort((a,b)=>{let x=a[sortKey],y=b[sortKey];if(sortKey==='qty'){x=+x;y=+y;}return (x<y?-1:x>y?1:0)*sortDir;});

  const tb=document.getElementById('rows');
  if(!list.length)tb.innerHTML=`<tr><td colspan="11" class="empty">Заказов не найдено</td></tr>`;
  else tb.innerHTML=list.map(o=>`<tr onclick="openOrder('${o.id}')">
      <td data-l="Заказчик"><div class="client-cell"><span class="sdot" style="background:${sColor(o.status)}" title="${sLabel(o.status)}"></span><div><div class="client-name">${esc(o.client)}</div><div class="sub">${esc(o.phone)}</div></div></div></td>
      <td data-l="Вид заказа">${esc(o.item)}</td>
      <td data-l="Дата">${o.date||'—'}</td>
      <td data-l="Сдать до" class="date ${isOver(o)?'over':''}">${o.deadline||'—'}${isOver(o)?' ⚠':''}</td>
      ${MATS.map(m=>matCell(o,m.k)).join('')}
      <td data-l="Кол-во" class="qty">${o.qty||1}</td>
    </tr>`).join('');

  document.getElementById('s-active').textContent=orders.filter(o=>o.status!=='issued').length;
  document.getElementById('s-over').textContent=orders.filter(isOver).length;
  const m=new Date().toISOString().slice(0,7);
  document.getElementById('s-rev').textContent=fmt(orders.filter(o=>(o.date||'').slice(0,7)===m).reduce((s,o)=>s+(+o.total||0),0));
  document.getElementById('s-debt').textContent=fmt(orders.reduce((s,o)=>s+Math.max(0,(+o.total||0)-(+o.prepaid||0)),0));
  saveOrders();
}

function openOrder(id){renderPanel(orders.find(x=>x.id===id),false);showPanel();}
function openNew(){
  const o={number:'ЗК-'+(1043+orders.length),client:'',phone:'',item:'',date:new Date().toISOString().slice(0,10),deadline:new Date().toISOString().slice(0,10),qty:1,master:'',status:'new',total:0,prepaid:0,priority:'normal',mats:{},notes:''};
  renderPanel(o,true);showPanel();
}
function renderPanel(o,editing){
  document.getElementById('p-title').textContent=editing?(o.id?'Изменить заказ':'Новый заказ'):(esc(o.item)||'Заказ');
  document.getElementById('p-num').textContent=o.number;
  const body=document.getElementById('p-body');
  if(!editing){
    const idx=STATUSES.findIndex(s=>s.id===o.status);
    const tl=STATUSES.map((s,i)=>`<div class="tl-step ${i<=idx?'done':''}"><span class="tl-dot"></span><span>${s.label}</span></div>`).join('');
    const debt=(+o.total)-(+o.prepaid);
    const mv=MATS.map(m=>{const v=(o.mats&&o.mats[m.k])||0;return `<div><div class="ml">${m.l}</div><div class="mv ${v>0?'':'z'}">${v}</div></div>`}).join('');
    body.innerHTML=`
      <div class="timeline">${tl}</div>
      <div class="field"><label>Заказчик</label><div>${esc(o.client)}${o.phone?' · '+esc(fmtPhone(o.phone)):''}</div></div>
      <div class="row2"><div class="field"><label>Дата</label><div>${o.date||'—'}</div></div><div class="field"><label>Дедлайн</label><div class="${isOver(o)?'date over':''}">${o.deadline||'—'}</div></div></div>
      <div class="row2"><div class="field"><label>Кол-во изделий</label><div>${o.qty||1}</div></div><div class="field"><label>Технолог</label><div>${esc(o.master||'—')}</div></div></div>
      <div class="row2"><div class="field"><label>Сумма</label><div>${fmt(o.total)}</div></div><div class="field"><label>Долг</label><div style="${debt>0?'color:var(--red)':''}">${debt>0?fmt(debt):'оплачено'}</div></div></div>
      <div class="field"><label>Расход материалов</label><div class="matview">${mv}</div></div>
      ${o.notes?`<div class="field"><label>Заметки</label><div>${esc(o.notes)}</div></div>`:''}`;
    const next=STATUSES[Math.min(idx+1,STATUSES.length-1)];
    document.getElementById('p-foot').innerHTML=`${o.status!=='issued'?`<button class="btn" onclick="advance('${o.id}')">→ ${next.label}</button>`:''}<button class="btn ghost" onclick="editOrder('${o.id}')">Изменить</button>`;
  }else{
    body.innerHTML=`
      <div class="row2"><div class="field"><label>Заказчик</label><select id="f-client" onchange="onOrderClientChange()">${clientOptions(o.client)}</select></div><div class="field"><label>Телефон</label><select id="f-phone">${phoneOptions(o.client,o.phone)}</select></div></div>
      <div class="field"><label>Вид заказа</label><select id="f-item">${typeOptions(o.item)}</select></div>
      <div class="row2"><div class="field"><label>Дата</label><input id="f-date" type="date" value="${o.date||''}"></div><div class="field"><label>Дедлайн</label><input id="f-deadline" type="date" value="${o.deadline||''}"></div></div>
      <div class="row2"><div class="field"><label>Кол-во изделий</label><input id="f-qty" type="number" min="1" value="${o.qty||1}"></div><div class="field"><label>Технолог</label><select id="f-master">${techOptions(o.master)}</select></div></div>
      <div class="row2"><div class="field"><label>Статус</label><select id="f-status">${STATUSES.map(s=>`<option value="${s.id}" ${s.id===o.status?'selected':''}>${s.label}</option>`).join('')}</select></div><div class="field"><label>Приоритет</label><select id="f-priority"><option value="normal" ${o.priority==='normal'?'selected':''}>Обычный</option><option value="high" ${o.priority==='high'?'selected':''}>Срочный</option></select></div></div>
      <div class="row2"><div class="field"><label>Сумма (сом)</label><input id="f-total" type="number" value="${o.total}"></div><div class="field"><label>Предоплата</label><input id="f-prepaid" type="number" value="${o.prepaid}"></div></div>
      <div class="field"><label>Кол-во материалов</label><div class="matgrid">${MATS.map(m=>`<div class="matnum"><label>${m.l}</label><input type="number" min="0" step="any" id="m-${m.k}" value="${(o.mats&&o.mats[m.k])||0}"></div>`).join('')}</div></div>
      <div class="field"><label>Заметки</label><textarea id="f-notes">${esc(o.notes)}</textarea></div>`;
    document.getElementById('p-foot').innerHTML=`<button class="btn" onclick="saveOrder('${o.id||''}','${o.number}')">Сохранить</button>${o.id?`<button class="btn ghost danger" onclick="delOrder('${o.id}')">Удалить</button>`:'<button class="btn ghost" onclick="closePanel()">Отмена</button>'}`;
  }
}
function editOrder(id){renderPanel(orders.find(x=>x.id===id),true);}
function saveOrder(id,number){
  const g=i=>document.getElementById(i).value;
  const obj={id:id||uid(),number,client:g('f-client'),phone:digitsOnly(g('f-phone')),item:g('f-item'),date:g('f-date'),deadline:g('f-deadline'),qty:+g('f-qty')||1,master:g('f-master'),status:g('f-status'),priority:g('f-priority'),total:+g('f-total')||0,prepaid:+g('f-prepaid')||0,mats:Object.fromEntries(MATS.map(m=>[m.k,+document.getElementById('m-'+m.k).value||0])),notes:g('f-notes')};
  if(!obj.client.trim()&&!obj.item.trim()){alert('Укажите заказчика и вид заказа');return;}
  if(id)orders=orders.map(o=>o.id===id?obj:o);else orders.unshift(obj);
  render();openOrder(obj.id);
}
function advance(id){const o=orders.find(x=>x.id===id);const i=STATUSES.findIndex(s=>s.id===o.status);if(i<STATUSES.length-1)o.status=STATUSES[i+1].id;render();openOrder(id);}
function delOrder(id){if(!confirm('Удалить заказ?'))return;orders=orders.filter(o=>o.id!==id);render();closePanel();}
function showPanel(){document.getElementById('panel').classList.add('show');document.getElementById('overlay').classList.add('show');}
function closePanel(){document.getElementById('panel').classList.remove('show');document.getElementById('overlay').classList.remove('show');}

/* ===== ЗАКАЗЧИКИ (настройки) ===== */
const CKEY='sewing_clients_v1';
let clients=loadClients();
function loadClients(){try{const d=JSON.parse(localStorage.getItem(CKEY));if(Array.isArray(d))return migrateClients(d);}catch(e){}return seedClients();}
function migrateClients(d){return d.map(c=>{
  let phones=Array.isArray(c.phones)?c.phones:[];
  if(!phones.length&&c.phone)phones=[digitsOnly(c.phone)];
  return {id:c.id||uid(),name:c.name,phones:phones.filter(Boolean)};
});}
function saveClients(){localStorage.setItem(CKEY,JSON.stringify(clients));}
function seedClients(){return [
  {id:uid(),name:'Айгерим С.',phones:['0700123456']},
  {id:uid(),name:'Эрмек Т.',phones:['0555987654','0312901234']},
  {id:uid(),name:'Школа №7',phones:['0312442211']},
];}

/* KG телефон: 10 цифр, начинается с 0. Хранится как цифры, показывается 0XXX XX XX XX */
function digitsOnly(s){return String(s||'').replace(/\D/g,'');}
function fmtPhone(d){
  d=digitsOnly(d).slice(0,10);
  if(!d)return '';
  const p=[d.slice(0,4),d.slice(4,6),d.slice(6,8),d.slice(8,10)].filter(Boolean);
  return p.join(' ');
}
function maskKG(el){el.value=fmtPhone(el.value);}
function phoneValid(d){d=digitsOnly(d);return d.length===10&&d[0]==='0';}

function addClient(){
  const ni=document.getElementById('newClientName');
  const pi=document.getElementById('newClientPhone');
  const name=ni.value.trim();const phone=digitsOnly(pi.value);
  if(!name){alert('Введите имя заказчика');return;}
  if(phone&&!phoneValid(phone)){alert('Телефон: 10 цифр, начинается с 0 (напр. 0700 12 34 56)');return;}
  if(clients.some(c=>c.name.toLowerCase()===name.toLowerCase())){alert('Такой заказчик уже есть');return;}
  clients.push({id:uid(),name,phones:phone?[phone]:[]});
  saveClients();ni.value='';pi.value='';renderClients();ni.focus();
}
function delClient(id){const c=clients.find(x=>x.id===id);if(!confirm('Удалить заказчика «'+(c?c.name:'')+'»?'))return;clients=clients.filter(x=>x.id!==id);saveClients();renderClients();}
function addClientPhone(id){
  const inp=document.getElementById('cp-'+id);const v=digitsOnly(inp.value);
  if(!v)return;
  if(!phoneValid(v)){alert('Телефон: 10 цифр, начинается с 0 (напр. 0700 12 34 56)');return;}
  const c=clients.find(x=>x.id===id);if(!c)return;if(!c.phones)c.phones=[];
  if(c.phones.includes(v)){inp.value='';return;}
  c.phones.push(v);saveClients();renderClients();
  setTimeout(()=>{const n=document.getElementById('cp-'+id);if(n)n.focus();},0);
}
function delClientPhone(id,p){const c=clients.find(x=>x.id===id);if(!c)return;c.phones=(c.phones||[]).filter(x=>x!==p);saveClients();renderClients();}

function renderClients(){
  const el=document.getElementById('clientList');if(!el)return;
  if(!clients.length){el.innerHTML='<div class="clist-empty">Список пуст. Добавьте первого заказчика.</div>';return;}
  el.innerHTML=clients.map(c=>{
    const phones=(c.phones||[]).length
      ? (c.phones).map(p=>`<span class="tag">${fmtPhone(p)}<button title="Удалить" onclick="delClientPhone('${c.id}','${p}')">×</button></span>`).join('')
      : '<span class="clist-empty">Номера не добавлены</span>';
    return `<div class="client-item">
      <div class="client-top">
        <div class="ci-name">${esc(c.name)}</div>
        <button title="Удалить заказчика" onclick="delClient('${c.id}')">×</button>
      </div>
      <div class="ci-types-label">Номера телефона</div>
      <div class="tag-list">${phones}</div>
      <div class="ci-add"><input id="cp-${c.id}" inputmode="numeric" placeholder="0700 00 00 00" oninput="maskKG(this)" onkeydown="if(event.key==='Enter')addClientPhone('${c.id}')"><button onclick="addClientPhone('${c.id}')">+</button></div>
    </div>`;
  }).join('');
}

/* опции select: заказчик, номера выбранного заказчика */
function clientOptions(sel){
  let opts='<option value="">— выбрать —</option>';let found=false;
  clients.forEach(c=>{const s=c.name===sel;if(s)found=true;opts+=`<option value="${esc(c.name)}" ${s?'selected':''}>${esc(c.name)}</option>`;});
  if(sel&&!found)opts+=`<option value="${esc(sel)}" selected>${esc(sel)}</option>`;
  return opts;
}
function phoneOptions(clientName,sel){
  const c=clients.find(x=>x.name===clientName);
  const list=c&&c.phones?c.phones:[];
  let opts='<option value="">— номер —</option>';let found=false;
  list.forEach(p=>{const s=p===sel;if(s)found=true;opts+=`<option value="${p}" ${s?'selected':''}>${fmtPhone(p)}</option>`;});
  if(sel&&!found)opts+=`<option value="${sel}" selected>${fmtPhone(sel)}</option>`;
  return opts;
}
function onOrderClientChange(){
  const name=document.getElementById('f-client').value;
  const c=clients.find(x=>x.name===name);
  // авто-выбор телефона: если один номер — сразу подставляем
  const auto=(c&&c.phones&&c.phones.length===1)?c.phones[0]:'';
  document.getElementById('f-phone').innerHTML=phoneOptions(name,auto);
}

/* ===== ТИПЫ ИЗДЕЛИЙ (настройки) ===== */
const TKEY='sewing_itemtypes_v1';
let itemTypes=loadTypes();
function loadTypes(){try{const d=JSON.parse(localStorage.getItem(TKEY));if(Array.isArray(d))return d;}catch(e){}return ['юбка','рубашка','платье','костюм','брюки'];}
function saveTypes(){localStorage.setItem(TKEY,JSON.stringify(itemTypes));}
function addType(){
  const inp=document.getElementById('newType');const v=inp.value.trim();
  if(!v)return;
  if(itemTypes.some(t=>t.toLowerCase()===v.toLowerCase())){alert('Такой тип уже есть');return;}
  itemTypes.push(v);saveTypes();inp.value='';renderTypes();renderWorkers();inp.focus();
}
function delType(t){
  if(!confirm('Удалить тип «'+t+'»?'))return;
  itemTypes=itemTypes.filter(x=>x!==t);saveTypes();renderTypes();renderWorkers();
}
function renderTypes(){
  const el=document.getElementById('typeList');
  if(!itemTypes.length){el.innerHTML='<div class="empty">Список пуст. Добавьте первый тип.</div>';return;}
  el.innerHTML=itemTypes.map(t=>`<span class="tag">${esc(t)}<button title="Удалить" onclick="delType('${esc(t).replace(/'/g,"\\'")}')">×</button></span>`).join('');
}

/* ===== ТЕХНОЛОГИ (настройки) ===== */
const TECHKEY='sewing_techs_v1';
let techs=loadTechs();
function loadTechs(){try{const d=JSON.parse(localStorage.getItem(TECHKEY));if(Array.isArray(d))return d;}catch(e){}return ['Гульнара','Жылдыз','Айбек'];}
function saveTechs(){localStorage.setItem(TECHKEY,JSON.stringify(techs));}
function addTech(){
  const inp=document.getElementById('newTech');const v=inp.value.trim();
  if(!v)return;
  if(techs.some(t=>t.toLowerCase()===v.toLowerCase())){alert('Такой технолог уже есть');return;}
  techs.push(v);saveTechs();inp.value='';renderTechs();inp.focus();
}
function delTech(t){
  if(!confirm('Удалить технолога «'+t+'»?'))return;
  techs=techs.filter(x=>x!==t);saveTechs();renderTechs();
}
function renderTechs(){
  const el=document.getElementById('techList');if(!el)return;
  if(!techs.length){el.innerHTML='<div class="empty">Список пуст. Добавьте первого технолога.</div>';return;}
  el.innerHTML=techs.map(t=>`<span class="tag">${esc(t)}<button title="Удалить" onclick="delTech('${esc(t).replace(/'/g,"\\'")}')">×</button></span>`).join('');
}
function techOptions(sel){
  let opts='<option value="">— выбрать —</option>';let found=false;
  techs.forEach(t=>{const s=t===sel;if(s)found=true;opts+=`<option value="${esc(t)}" ${s?'selected':''}>${esc(t)}</option>`;});
  if(sel&&!found)opts+=`<option value="${esc(sel)}" selected>${esc(sel)}</option>`;
  return opts;
}

/* ===== РАБОТНИКИ ===== */
const WKEY='sewing_workers_v1';
let workers=loadWorkers();
function loadWorkers(){try{const d=JSON.parse(localStorage.getItem(WKEY));if(Array.isArray(d))return d;}catch(e){}return seedWorkers();}
function saveWorkers(){localStorage.setItem(WKEY,JSON.stringify(workers));}
function seedWorkers(){const t=new Date();const d=n=>{const x=new Date(t);x.setDate(x.getDate()+n);return x.toISOString().slice(0,10);};return [
  {id:uid(),name:'Гульнара',role:'швея',item:'юбка',due:d(3),qty:24,price:150},
  {id:uid(),name:'Жылдыз',role:'швея',item:'рубашка',due:d(5),qty:18,price:200},
  {id:uid(),name:'Айбек',role:'закройщик',item:'костюм',due:d(-1),qty:6,price:400},
];}

function setW(id,field,val){
  const w=workers.find(x=>x.id===id);if(!w)return;
  if(field==='qty'||field==='price')w[field]=Math.max(0,+val||0);else w[field]=val;
  saveWorkers();renderWorkers();
}
function stepW(id,field,delta){
  const w=workers.find(x=>x.id===id);if(!w)return;
  w[field]=Math.max(0,(+w[field]||0)+delta);
  saveWorkers();renderWorkers();
}
function addWorker(){
  workers.push({id:uid(),name:'',role:'',item:'',due:'',qty:0,price:0});
  saveWorkers();renderWorkers();
  const inputs=document.querySelectorAll('#wrows tr:last-child .winput');
  if(inputs[0])inputs[0].focus();
}
function delW(id){workers=workers.filter(w=>w.id!==id);saveWorkers();renderWorkers();}

function typeOptions(sel){
  let opts='<option value="">—</option>';
  let found=false;
  itemTypes.forEach(t=>{const s=t===sel;if(s)found=true;opts+=`<option value="${esc(t)}" ${s?'selected':''}>${esc(t)}</option>`;});
  if(sel&&!found)opts+=`<option value="${esc(sel)}" selected>${esc(sel)}</option>`;
  return opts;
}
function renderWorkers(){
  const q=document.getElementById('wq').value.toLowerCase().trim();
  let list=workers;
  if(q)list=workers.filter(w=>(w.name+w.role+w.item).toLowerCase().includes(q));
  const tb=document.getElementById('wrows');
  if(!list.length)tb.innerHTML=`<tr><td colspan="8" class="empty">Нет записей. Нажми «+ Добавить работника».</td></tr>`;
  else tb.innerHTML=list.map(w=>{
    const sum=(+w.qty||0)*(+w.price||0);
    return `<tr>
      <td data-l="Имя"><input class="winput" value="${esc(w.name)}" placeholder="Имя" onchange="setW('${w.id}','name',this.value)"></td>
      <td data-l="Тип работы"><input class="winput" value="${esc(w.role)}" placeholder="швея" onchange="setW('${w.id}','role',this.value)"></td>
      <td data-l="Тип изделия"><select class="winput" onchange="setW('${w.id}','item',this.value)">${typeOptions(w.item)}</select></td>
      <td data-l="Сдать до" class="${w.due&&w.due<new Date().toISOString().slice(0,10)?'date over':''}"><input class="winput" type="date" value="${w.due||''}" onchange="setW('${w.id}','due',this.value)"></td>
      <td data-l="Сделано"><div class="stepper"><button onclick="stepW('${w.id}','qty',-1)">−</button><input type="number" min="0" value="${w.qty}" onfocus="this.select()" onchange="setW('${w.id}','qty',this.value)"><button onclick="stepW('${w.id}','qty',1)">+</button></div></td>
      <td data-l="Цена/ед"><div class="stepper"><button onclick="stepW('${w.id}','price',-10)">−</button><input type="number" min="0" value="${w.price}" onfocus="this.select()" onchange="setW('${w.id}','price',this.value)"><button onclick="stepW('${w.id}','price',10)">+</button></div></td>
      <td data-l="Сумма" class="wsum">${fmt(sum)}</td>
      <td><button class="delx" title="Удалить" onclick="delW('${w.id}')">×</button></td>
    </tr>`;
  }).join('');

  document.getElementById('w-count').textContent=new Set(workers.map(w=>w.name.trim().toLowerCase()).filter(Boolean)).size||workers.length;
  document.getElementById('w-items').textContent=workers.reduce((s,w)=>s+(+w.qty||0),0);
  const pay=workers.reduce((s,w)=>s+(+w.qty||0)*(+w.price||0),0);
  document.getElementById('w-pay').textContent=fmt(pay);
  document.getElementById('w-total').textContent=fmt(pay);
  saveWorkers();
}

render();
renderWorkers();
renderTypes();
renderTechs();
renderClients();

if('serviceWorker' in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('sw.js').catch(()=>{}));}

</script>
